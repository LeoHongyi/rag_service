# Env
ENVIRONMENT='dev'
# Database
DATABASE_TYPE='postgresql'
DATABASE_HOST='127.0.0.1'
DATABASE_PORT=5432
DATABASE_USER='postgres'
DATABASE_PASSWORD='123456'
# Redis
REDIS_HOST='127.0.0.1'
REDIS_PORT=6379
REDIS_PASSWORD=''
REDIS_DATABASE=0
# Token
TOKEN_SECRET_KEY='REPLACE_WITH_YOUR_OWN_SECRET_KEY_DO_NOT_USE_THIS_VALUE'
# [ App ] task
# Celery
CELERY_BROKER_REDIS_DATABASE=1
# Rabbitmq
CELERY_RABBITMQ_HOST='127.0.0.1'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='guest'
CELERY_RABBITMQ_PASSWORD='guest'
# [ Plugin ] oauth2
OAUTH2_GITHUB_CLIENT_ID='test'
OAUTH2_GITHUB_CLIENT_SECRET='test'
OAUTH2_GOOGLE_CLIENT_ID='test'
OAUTH2_GOOGLE_CLIENT_SECRET='test'
# [ Plugin ] email
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
# [ App ] rag
RAG_STORAGE_PROVIDER='local'
RAG_STORAGE_LOCAL_PATH='./data/rag-objects'
RAG_CHAT_BASE_URL=''
RAG_CHAT_API_KEY=''
RAG_EMBEDDING_BASE_URL=''
RAG_EMBEDDING_API_KEY=''
RAG_EMBEDDING_TIMEOUT_SECONDS=30
# 未配置模型服务时是否允许本地伪向量与占位答案。ENVIRONMENT='prod' 会强制为 false；
# 若生产主机沿用 dev 配置，必须在此显式设为 false，否则索引与问答会基于伪数据。
RAG_ALLOW_LOCAL_MODEL_FALLBACK=true
RAG_INDEX_MAX_RETRIES=3
RAG_INDEX_RETRY_BACKOFF_MAX_SECONDS=60
RAG_INDEX_STALE_SECONDS=900
RAG_OUTBOX_DISPATCH_INTERVAL_SECONDS=5
RAG_REPAIR_INTERVAL_SECONDS=60
RAG_MAX_FILE_SIZE=20971520
RAG_PDF_MAX_PAGES=100
RAG_PDF_MAX_TEXT_CHARS=1000000
RAG_DENSE_RRF_WEIGHT=1.0
RAG_LEXICAL_RRF_WEIGHT=0.5
RAG_PARENT_CONTEXT_ENABLED=false
RAG_RERANK_ENABLED=false
RAG_RERANK_PROTOCOL='openai'
RAG_RERANK_BASE_URL=''
RAG_RERANK_API_KEY=''
RAG_RERANK_MODEL=''
RAG_RERANK_TIMEOUT_SECONDS=5
RAG_RERANK_INPUT_PRICE_PER_MILLION_TOKENS=0
RAG_CHAT_INPUT_PRICE_PER_MILLION_TOKENS=0
RAG_CHAT_OUTPUT_PRICE_PER_MILLION_TOKENS=0
